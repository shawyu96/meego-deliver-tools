#!/bin/bash
# =====================================================================
# Meego 插件工具 — Mac 双击启动器
# 双击此文件即可启动，无需打开终端手动输入命令
# =====================================================================

cd "$(dirname "$0")"

echo "=========================================="
echo "  Meego 插件工具 启动器"
echo "=========================================="
echo ""

# 检查 Node.js
if ! command -v node &>/dev/null; then
  echo "✘ 未检测到 Node.js，请先安装：https://nodejs.org"
  echo "按回车键关闭..."
  read
  exit 1
fi

echo "✓ Node.js $(node -v)"

# 赋予 setup.sh 可执行权限
chmod +x setup.sh

# 后台延时打开浏览器（等服务启动）
(sleep 5 && open http://127.0.0.1:3000) &

# 启动服务
./setup.sh
